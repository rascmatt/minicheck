cabal-version:      3.0
name:               minicheck
version:            0.1.0.0
synopsis:           CTL Model Checker written in Haskell
-- description:
homepage:           https://github.com/rascmatt/minicheck
license:            BSD-3-Clause
license-file:       LICENSE
author:             Andrey Proskurin, Matthias Raschhofer
maintainer:         e11908082@student.tuwien.ac.at
copyright:          2025 Andrey Proskurin, Matthias Raschhofer
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable minicheck
    import:           warnings
    main-is:          Main.hs
    other-modules:    Lib.Parser.Base,Lib.Parser.TS,Lib.Parser.CTL,Lib.Model.TS,Lib.Model.CTL,Lib.Verify.Check,Lib.Parser.Options
    -- other-extensions:
    build-depends:    containers ^>=0.6.7, base ^>=4.17.2.1
    hs-source-dirs:   app
    default-language: Haskell2010
